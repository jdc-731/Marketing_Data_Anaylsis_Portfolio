----DATA EXAMINATION----

SELECT 
    SUM(IF(age IS NULL, 1, 0)) AS missing_age,
    SUM(IF(job IS NULL, 1, 0)) AS missing_job,
    SUM(IF(marital IS NULL, 1, 0)) AS missing_marital,
    SUM(IF(education IS NULL, 1, 0)) AS missing_education,
    SUM(IF(campaign IS NULL, 1, 0)) AS missing_campaign,
    SUM(IF(balance IS NULL, 1, 0)) AS missing_balance,
    SUM(IF(housing IS NULL, 1, 0)) AS missing_housing,
    SUM(IF(loan IS NULL, 1, 0)) AS missing_loan,
    -- The grand total of all missing data combined:
    (SUM(IF(age IS NULL, 1, 0)) + SUM(IF(job IS NULL, 1, 0)) + 
     SUM(IF(marital IS NULL, 1, 0)) + SUM(IF(education IS NULL, 1, 0)) + 
     SUM(IF(campaign IS NULL, 1, 0)) + SUM(IF(balance IS NULL, 1, 0)) + 
     SUM(IF(housing IS NULL, 1, 0)) + SUM(IF(loan IS NULL, 1, 0))) AS grand_total_missing
FROM `intricate-tempo-511123-b0.Bank_bd.Bank`;


---- IDENTIFYING WHICH CHANNELS HAVE THE HIGHEST CONVERSION RATE ----


SELECT 
  contact AS marketing_channel,
COUNT(*) AS total_customers,
COUNTIF ( y = true) AS conversions,
ROUND(COUNTIF( y = true) * 100.0 /COUNT(*), 2) AS conversion_rate_pct
FROM `intricate-tempo-511123-b0.Bank_bd.Bank` 
GROUP BY contact
ORDER BY conversion_rate_pct DESC;


---- NUMBER OF TIMES CONTACTED VS CONVERSION RATE ----


SELECT  
  CASE
  WHEN campaign = 1 then '1 touch'
  WHEN campaign = 2 THEN '2 touches'
  WHEN campaign = 3 THEN '3 touches'
  WHEN campaign = 4 THEN '4 touches'
  WHEN campaign BETWEEN 5 AND 9 THEN '5-9 touches'
  WHEN '10+ touches (spam)'
ELSE 'Unknown'
  END AS contact_frequency,
COUNT(*) total_customers,
  COUNTIF ( y = true) AS conversions,
  ROUND (COUNTIF( y = true) * 100.0 /COUNT(*),2) AS conversion_rate_pct
FROM `intricate-tempo-511123-b0.Bank_bd.Bank` 
Group By contact_frequency
Order By MIN(campaign); 


