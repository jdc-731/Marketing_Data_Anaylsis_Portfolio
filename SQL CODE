SELECT  
CASE
  When age < 25 then 'Gen Z'
  When age between 25 and 40 then 'Millennial'
  When age between 41 and 56 then 'Gen X'
  When age Between 57 and 75 then 'Boomer'
  Else 'Silent Generation' 
End As Generation, 
job,
marital,
education,
COUNT(*) as total_customers,
CountIF (y = true) As conversions,
ROUND(countif ( y = true) * 100.0/COunt(*), 2) As conversion_rate_pct
FROM `intricate-tempo-511123-b0.Bank_bd.Bank` 
Group By 1, 2, 3, 4
HAVING total_customers >= 50 
Order By conversion_rate_pct DESC; 
