----DATA EXAMINATION----


--Any missing data--
SELECT
  COUNT(*) AS total_rows,
  COUNTIF(age IS NULL) AS null_age,
  COUNTIF(balance IS NULL) AS null_balance,
  COUNTIF (campaign IS NULL) AS nulll_campaign,
  COUNTIF ( y IS NULL) AS null_y,
  COUNTIF(job IS NULL OR job = 'unknown') AS missing_job, 
  COUNTIF (marital IS NULL OR marital = 'unknown') AS missing_martial_status,
  COUNTIF (education IS NULL OR education = 'unknown') AS missing_education,
  COUNTIF(contact IS NULL OR contact = 'unknown') AS missing_contact, 
  ROUND(COUNTIF(contact IS NULL OR contact= 'unkown') * 100.00 / COUNT (*), 2) AS pct_missing_contact
FROM `intricate-tempo-511123-b0.Bank_bd.Bank`; 


--Any min, max, and duplicates--


SELECT  
  MIN(age) AS min_age,
  MAX(age) AS max_age,
  MIN(campaign) AS min_campaign,
  MAX(campaign) AS max_campaign,
  MIN(balance) AS min_balance,
  MAX(balance) AS max_balance,
  COUNT(*) - COUNT (DISTINCT TO_JSON_STRING(t)) AS duplicate_rows
FROM `intricate-tempo-511123-b0.Bank_bd.Bank` AS t; 


---- IDENTIFYING WHICH CHANNELS HAVE THE HIGHEST CONVERSION RATE ----


SELECT 
  contact AS marketing_channel,
COUNT(*) AS total_customers,
COUNTIF ( y = true) AS conversions,
ROUND(COUNTIF( y = true) * 100.0 /COUNT(*), 2) AS conversion_rate_pct
FROM `intricate-tempo-511123-b0.Bank_bd.Bank` 
GROUP BY contact
ORDER BY conversion_rate_pct DESC;


---- NUMBER OF TIMES CONTACTED VS CONVERSION RATE ----


SELECT  
  CASE
  WHEN campaign = 1 then '1 touch'
  WHEN campaign = 2 THEN '2 touches'
  WHEN campaign = 3 THEN '3 touches'
  WHEN campaign = 4 THEN '4 touches'
  WHEN campaign BETWEEN 5 AND 9 THEN '5-9 touches'
  WHEN '10+ touches THEN (spam)'
ELSE 'Unknown'
  END AS contact_frequency,
COUNT(*) total_customers,
  COUNTIF ( y = true) AS conversions,
  ROUND (COUNTIF( y = true) * 100.0 /COUNT(*),2) AS conversion_rate_pct
FROM `intricate-tempo-511123-b0.Bank_bd.Bank` 
Group By contact_frequency
Order By MIN(campaign); 


